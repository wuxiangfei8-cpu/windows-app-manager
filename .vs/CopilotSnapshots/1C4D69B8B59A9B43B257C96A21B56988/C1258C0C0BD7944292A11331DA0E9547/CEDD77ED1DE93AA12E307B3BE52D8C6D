            self.dock_paths.remove(path)
            self.save_user_config()
            self._render_android_dock(THEMES["android"])

    def remove_from_folders(self, path, refresh=True):
        for paths in self.app_folders.values():
            paths.discard(path)
        if refresh:
            self.save_user_config()
            self.render_apps()

    def open_folder(self, folder_name):
        dialog = tk.Toplevel(self)
        dialog.title(folder_name)
        dialog.geometry("620x500")
        dialog.transient(self)
        title_row = ttk.Frame(dialog)
        title_row.pack(fill=tk.X, padx=12, pady=10)
        name_var = tk.StringVar(value=folder_name)
        ttk.Entry(title_row, textvariable=name_var, width=25).pack(side=tk.LEFT)
        search_var = tk.StringVar()
        ttk.Entry(title_row, textvariable=search_var, width=25).pack(side=tk.RIGHT)
        ttk.Label(title_row, text="搜索：").pack(side=tk.RIGHT, padx=4)

        canvas = tk.Canvas(dialog, highlightthickness=0, bg=THEMES["android"]["background"])
        scrollbar = ttk.Scrollbar(dialog, orient=tk.VERTICAL, command=canvas.yview)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(12, 0), pady=(0, 12))
        content = tk.Frame(canvas, bg=THEMES["android"]["background"])
        canvas.create_window((0, 0), window=content, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        content.bind("<Configure>", lambda _: canvas.configure(scrollregion=canvas.bbox("all")))

        def render_folder(*_):
            for child in content.winfo_children():
                child.destroy()
            query = search_var.get().strip().casefold()
            apps = [app for app in self.apps
                    if app.path in self.app_folders.get(folder_name, set())
                    and (not query or query in app.name.casefold() or query in app.path.casefold())]
            for index, app in enumerate(apps):
                row, column = divmod(index, 4)
                card = tk.Frame(content, bg=THEMES["android"]["card"], width=130, height=145,
                                highlightthickness=1, highlightbackground="#dfe3e8")
                card.grid(row=row, column=column, padx=8, pady=8)
                card.grid_propagate(False)
                icon = tk.Label(card, bg=THEMES["android"]["card"])
                icon.pack(pady=(8, 4))
                placeholder = self._placeholder_icon(app, 58)
                if ImageTk and placeholder:
                    icon.image = ImageTk.PhotoImage(placeholder)
                    icon.configure(image=icon.image)
                else:
                    icon.configure(text="APP", fg=THEMES["android"]["accent"])
                label = tk.Label(card, text=app.name, bg=THEMES["android"]["card"],
                                 fg=THEMES["android"]["text"], wraplength=115)
                label.pack(fill=tk.X)
                for widget in (card, icon, label):
                    widget.bind("<Double-1>", lambda _, path=app.path: self.launch_path(path))
                    widget.bind("<Button-3>", lambda event, path=app.path:
                                self.remove_from_folder_from_dialog(folder_name, path, dialog))
                self.after(10, lambda app=app, icon=icon: self._load_card_icon(app, icon, 58))
            content.update_idletasks()
            canvas.configure(scrollregion=canvas.bbox("all"))

        search_var.trace_add("write", render_folder)
        render_folder()

        def rename_folder():
            new_name = name_var.get().strip()
            if not new_name or new_name == folder_name:
                return
            if new_name in self.app_folders:
                messagebox.showerror("文件夹名称", "该文件夹名称已存在", parent=dialog)
                return
            self.app_folders[new_name] = self.app_folders.pop(folder_name)
            self.save_user_config()
            dialog.title(new_name)
            self.render_apps()

        ttk.Button(dialog, text="保存名称", command=rename_folder).pack(pady=(0, 10))

    def remove_from_folder_from_dialog(self, folder_name, path, dialog):
        self.app_folders.get(folder_name, set()).discard(path)
        self.save_user_config()
        dialog.destroy()
        self.render_apps()

    def _placeholder_icon(self, app, size):
        if Image is None:
            return None
        theme = THEMES[self.theme_name]
        image = Image.new("RGBA", (size, size), theme["accent"])
        if ImageDraw:
            draw = ImageDraw.Draw(image)
            letter = (app.name.strip() or "A")[0].upper()
            draw.text((size // 2, size // 2), letter, fill="white", anchor="mm")
        return self._shape_icon_image(image)

    def _shape_icon_image(self, image):
        if Image is None or self.icon_shape == "square":
            return image
        mask = Image.new("L", image.size, 0)
        draw = ImageDraw.Draw(mask)
        bounds = (0, 0, image.width - 1, image.height - 1)
        if self.icon_shape == "circle":
            draw.ellipse(bounds, fill=255)
        else:
            draw.rounded_rectangle(bounds, radius=max(8, image.width // 5), fill=255)
        image = image.copy()
        image.putalpha(mask)
        return image

    def _load_card_icon(self, app, icon_label, size=96):
        if not icon_label.winfo_exists():
            return
        image = get_icon_image(app, size)
        if image is None:
            return
        if ImageTk:
            icon_label.image = ImageTk.PhotoImage(self._shape_icon_image(image))
            icon_label.configure(image=icon_label.image)

    def select_card(self, iid, launch=False):
        app = self.app_by_iid.get(iid)
        if app is None:
            return
        self.selected_app_path = app.path
        for card_iid, card in self.card_widgets.items():
            selected = card_iid == iid
            card.configure(highlightbackground=THEMES[self.theme_name]["accent"] if selected else "#3a3a3a",
                           highlightthickness=2 if selected else 1)
        if launch:
            self.launch_selected()

    def _resize_card_frame(self, event):
        self.card_canvas.itemconfigure(self.card_window, width=max(event.width, 850))
        if (self.theme_name == "android" and hasattr(self, "_android_items")
                and abs(event.width - self.android_last_width) > 20):
            self.android_last_width = event.width
            self.after_idle(self._render_android_page)

    def toggle_theme(self):
        theme_order = tuple(sorted(THEMES.keys()))
        self.theme_name = theme_order[(theme_order.index(self.theme_name) + 1) % len(theme_order)]
        self.config_data["theme"] = self.theme_name
        self.save_user_config()
        self.apply_theme()
        self.render_apps()

    def apply_theme(self):
        theme = THEMES[self.theme_name]
        self.configure(bg=theme["background"])
        if hasattr(self, 'card_canvas'):
            self.card_canvas.configure(bg=theme["background"])
        if hasattr(self, 'card_frame'):
            self.card_frame.configure(bg=theme["background"])
        if hasattr(self, 'dock_frame'):
            self.dock_frame.configure(bg=theme["background"])
        if hasattr(self, 'folder_list'):
            style_listbox(self.folder_list, theme)
        if hasattr(self, 'theme_label'):
            self.theme_label.configure(text=f"当前：{theme['name']}")

        if self.theme_name == "android":
            if str(self.scan_panel) in self.main_pane.panes():
                self.main_pane.forget(self.scan_panel)
            if hasattr(self, 'android_page_label'):
                self.android_page_label.pack(side=tk.LEFT)
            if hasattr(self, 'android_prev_button'):
                self.android_prev_button.pack(side=tk.RIGHT)
            if hasattr(self, 'android_next_button'):
                self.android_next_button.pack(side=tk.RIGHT, padx=(4, 0))
            if hasattr(self, 'dock_frame'):
                self.dock_frame.pack(fill=tk.X, pady=(6, 0))
        else:
            if str(self.scan_panel) not in self.main_pane.panes():
                self.main_pane.insert(0, self.scan_panel, weight=0)
            if hasattr(self, 'android_page_label'):
                self.android_page_label.pack_forget()
            if hasattr(self, 'android_prev_button'):
                self.android_prev_button.pack_forget()
            if hasattr(self, 'android_next_button'):
                self.android_next_button.pack_forget()
            if hasattr(self, 'dock_frame'):
                self.dock_frame.pack_forget()

        self.apply_theme_config()

    @staticmethod
    def _matches_search(app, query):
        return not query or query in app.name.lower() or query in app.path.lower()

    def _is_hidden(self, path):
        normalized = os.path.normcase(os.path.abspath(path))
        return any(normalized == os.path.normcase(os.path.abspath(item))
                   for item in self.hidden_paths)

    @staticmethod
    def _app_values(app):
        return (
            app.name, app.path, app.size_text,
            "完整" if app.metadata.has_version_metadata else "缺失",
            app.metadata.subsystem_text,
            "可提取" if app.metadata.has_icon else "无",
            f"{app.metadata.confidence_score}%",
        )

