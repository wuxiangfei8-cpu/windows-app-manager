    def refresh_folder_list(self):
        self.folder_list.delete(0, tk.END)
        for folder in self.folders:
            self.folder_list.insert(tk.END, folder)

    def save_user_config(self):
        save_config(self.folders, self.excludes, self.filters, self.theme_name, self.app_folders,
                    self.desktop_order, self.dock_paths, {
                        "columns": self.desktop_columns,
                        "rows": self.desktop_rows,
                        "layout_mode": self.layout_mode,
                        "icon_shape": self.icon_shape,
                        "positions": self.desktop_positions,
                    }, self.hidden_paths, self.badges)

    def change_android_page(self, delta):
        if self.theme_name != "android":
            return
        page_size = self.desktop_columns * self.desktop_rows
        page_count = max(1, (len(self._android_items) + page_size - 1) // page_size)
        self.android_page = max(0, min(self.android_page + delta, page_count - 1))
        self._render_android_page()

    def add_folder(self):
        folder = filedialog.askdirectory(title="选择扫描目录")
        if folder and folder not in self.folders:
            self.folders.append(folder)
            self.save_user_config()
            self.refresh_folder_list()

    def remove_folder(self):
        selected = list(self.folder_list.curselection())
        for index in reversed(selected):
            del self.folders[index]
        self.save_user_config()
        self.refresh_folder_list()

    def start_scan(self):
        if not self.folders:
            self.status.config(text="请先添加至少一个扫描目录")
            return
        self.scan_button.config(state=tk.DISABLED)
        self.progress.configure(mode="indeterminate", value=0)
        self.progress.start(12)
        self.status.config(text="正在扫描并进行降噪筛选……")
        self.apps = []
        self.render_apps()

        def worker():
            def progress(done, total):
                self.after(0, lambda: self.update_scan_progress(done, total))

            results = scan_executables(self.folders, self.excludes, self.filters,
                                       on_progress=progress)
            self.after(0, lambda: self.scan_finished(results))

        threading.Thread(target=worker, daemon=True).start()

    def scan_finished(self, results):
        self.progress.stop()
        self.progress.configure(mode="determinate", maximum=1, value=1)
        self.scan_button.config(state=tk.NORMAL)
        self.apps = results
        save_scan_cache(self.folders, self.excludes, self.filters, results)
        self.status.config(text=f"筛选完成：保留 {len(results)} 个 GUI 应用")
        self.render_apps()

    def update_scan_progress(self, done, total):
        if total <= 0:
            self.progress.stop()
            self.progress.configure(mode="determinate", maximum=1, value=1)
            self.status.config(text="未找到 EXE 文件")
            return
        if str(self.progress.cget("mode")) == "indeterminate":
            self.progress.stop()
            self.progress.configure(mode="determinate", maximum=total, value=0)
        self.progress.configure(value=done)
        self.status.config(text=f"正在扫描：{done}/{total} 个 EXE，进行降噪筛选……")

    def render_apps(self):
        query = self.search.get().strip().lower()
        sort_key = self.sort_value.get()
        self.filtered_apps = [app for app in self.apps
                              if self._matches_search(app, query)
                              and not self._is_hidden(app.path)]
        if sort_key == "大小":
            self.filtered_apps.sort(key=lambda app: app.size, reverse=True)
        elif sort_key == "修改时间":
            self.filtered_apps.sort(key=lambda app: app.modified, reverse=True)
        else:
            self.filtered_apps.sort(key=lambda app: app.name.lower())
        if self.theme_name == "android":
            self._render_android_apps(query)
            return
        for child in self.card_frame.winfo_children():
            child.destroy()
        self.app_by_iid = {}
        self.card_widgets = {}
        self.selected_app_path = None
        self.current_card_row = None
        display_index = 0
        for folder_name in sorted(self.app_folders, key=str.casefold):
            folder_apps = [app for app in self.filtered_apps
                           if app.path in self.app_folders[folder_name]]
            if query and query not in folder_name.casefold() and not folder_apps:
                continue
            self._create_folder_card(display_index, folder_name)
            display_index += 1
        assigned_paths = {path for paths in self.app_folders.values() for path in paths}
        for app in self.filtered_apps:
            if app.path in assigned_paths:
                continue
            self._create_app_card(display_index, app)
            display_index += 1
        self.card_frame.update_idletasks()
        self.card_canvas.configure(scrollregion=self.card_canvas.bbox("all"))
        self.count_label.config(text=f"{len(self.filtered_apps)} / {len(self.apps)} 个应用")

    def _render_android_apps(self, query):
        folder_items = []
        for folder_name in sorted(self.app_folders, key=str.casefold):
            folder_apps = [app for app in self.filtered_apps
                            if app.path in self.app_folders[folder_name]]
            if not query or query in folder_name.casefold() or folder_apps:
                folder_items.append(("folder", folder_name))

        assigned = {path for paths in self.app_folders.values() for path in paths}
        apps = [app for app in self.filtered_apps if app.path not in assigned]
        order = {path: index for index, path in enumerate(self.desktop_order)}
        apps.sort(key=lambda app: (order.get(app.path, len(order)), app.name.casefold()))
        self._android_items = folder_items + [("app", app) for app in apps]
        page_size = self.desktop_columns * self.desktop_rows
        page_count = max(1, (len(self._android_items) + page_size - 1) // page_size)
        self.android_page = min(self.android_page, page_count - 1)
        self._render_android_page()
        self.count_label.config(text=f"{len(self.filtered_apps)} / {len(self.apps)} 个应用")

    def _render_android_page(self):
        for child in self.card_frame.winfo_children():
            child.destroy()
        self.app_by_iid = {}
        self.card_widgets = {}
        self.android_app_cards = []
        self.selected_app_path = None
        page_size = self.desktop_columns * self.desktop_rows
        page_items = self._android_items[self.android_page * page_size:
                                         (self.android_page + 1) * page_size]
        theme = THEMES["android"]
        for column in range(self.desktop_columns):
            self.card_frame.grid_columnconfigure(column, weight=1)
        for index, (kind, value) in enumerate(page_items):
            row, column = divmod(index, self.desktop_columns)
            if kind == "folder":
                self._create_android_folder(row, column, value, theme)
            else:
                self._create_android_app(row, column, value, theme)
        page_count = max(1, (len(self._android_items) + page_size - 1) // page_size)
        self.android_page_label.configure(text=f"第 {self.android_page + 1} / {page_count} 页")
        self.android_prev_button.configure(state=tk.NORMAL if self.android_page else tk.DISABLED)
        self.android_next_button.configure(state=tk.NORMAL if self.android_page < page_count - 1
                                            else tk.DISABLED)
        self._render_android_dock(theme)

    def _create_android_app(self, row, column, app, theme):
        iid = f"android-app-{row}-{column}"
        self.app_by_iid[iid] = app
        icon_size = self._android_icon_size()
        card = tk.Frame(self.card_frame, bg=theme["card"], width=130, height=180,
                        highlightthickness=1, highlightbackground="#3a3a3a")
        card.grid(row=row, column=column, padx=8, pady=8, sticky="nsew")
        card.grid_propagate(False)
        if self.layout_mode == "free":
            x, y = self.desktop_positions.get(app.path, (column * 146, row * 194))
            card.grid_forget()
            card.place(x=x, y=y)
        icon = tk.Label(card, bg=theme["card"], fg=theme["accent"], width=6, height=3,
                        relief=tk.FLAT)
        icon.pack(pady=(2, 4))
        placeholder = self._placeholder_icon(app, icon_size)
        if ImageTk and placeholder:
            icon.image = ImageTk.PhotoImage(placeholder)
            icon.configure(image=icon.image)
        else:
            icon.configure(text=(app.name[:1] or "A").upper(), font=("Segoe UI", 22, "bold"))
        name = tk.Label(card, text=app.name, bg=theme["card"], fg=theme["text"],
                        font=("Segoe UI", 9), wraplength=120, justify=tk.CENTER)
        name.pack(fill=tk.X)
        badge_value = self.badges.get(app.path, "")
        badge = None
        if badge_value and badge_value not in ("0", "None"):
            badge = tk.Label(card, text=badge_value, bg="#e53935", fg="white",
                             font=("Segoe UI", 8, "bold"), padx=4, pady=1)
            badge.place(relx=1.0, x=-5, y=5, anchor="ne")
        self.card_widgets[iid] = card
        self.android_app_cards.append((card, app.path, iid))
        for widget in (card, icon, name):
            widget.bind("<Enter>", lambda _, target=card: self._set_android_card_hover(target, True))
            widget.bind("<Leave>", lambda _, target=card: self._set_android_card_hover(target, False))
            widget.bind("<Button-1>", lambda _, key=iid: self.select_card(key))
            widget.bind("<Double-1>", lambda _, key=iid: self.select_card(key, launch=True))
            widget.bind("<Button-3>", lambda event, key=iid: self.show_app_menu(event, key))
            widget.bind("<ButtonPress-1>", lambda event, path=app.path, key=iid:
                        self._android_press(event, path, key))
            widget.bind("<B1-Motion>", self._android_motion)
            widget.bind("<ButtonRelease-1>", self._android_release)
        self.after(10, lambda: self._load_card_icon(app, icon, icon_size))

    def _android_icon_size(self):
        available_width = self.card_canvas.winfo_width()
        if available_width <= 1:
            available_width = 850
        return max(44, min(88, (available_width // self.desktop_columns) - 38))

    def _set_android_card_hover(self, card, hovered):
        if self.android_dragging:
            return
        color = "#333333" if hovered else THEMES["android"]["card"]
        card.configure(bg=color)
        for child in card.winfo_children():
            if child.winfo_exists():
                child.configure(bg=color)

