@dataclass(frozen=True)
class ExecutableInfo:
    file_description: str = ""
    product_name: str = ""
    company_name: str = ""
    subsystem: int | None = None
    has_icon: bool = False

    @property
    def display_name(self):
        return self.product_name or self.file_description or ""

    @property
    def has_version_metadata(self):
        return bool(self.file_description or self.product_name or self.company_name)

    @property
    def has_required_identity(self):
        return bool(self.product_name or self.company_name)

    @property
    def subsystem_text(self):
        return {IMAGE_SUBSYSTEM_WINDOWS_GUI: "GUI", IMAGE_SUBSYSTEM_WINDOWS_CUI: "CUI"}.get(
            self.subsystem, "未知"
        )

    @property
    def confidence_score(self):
        score = 0
        if self.has_version_metadata:
            score += 40
        if self.subsystem == IMAGE_SUBSYSTEM_WINDOWS_GUI:
            score += 30
        if self.has_icon:
            score += 20
        return score + 10


@dataclass(frozen=True)
class Application:
    name: str
    path: str
    size: int
    modified: float
    metadata: ExecutableInfo = field(default_factory=ExecutableInfo)
    filter_note: str = ""

    @property
    def modified_text(self):
        return datetime.fromtimestamp(self.modified).strftime("%Y-%m-%d %H:%M")

    @property
    def size_text(self):
        size = float(self.size)
        for unit in ("B", "KB", "MB", "GB"):
            if size < 1024 or unit == "GB":
                return f"{size:.1f} {unit}" if unit != "B" else f"{int(size)} B"
            size /= 1024


def load_config():
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_config(folders, excludes, filters=None, theme=None, app_folders=None,
                desktop_order=None, dock_paths=None, desktop_settings=None,
                hidden_paths=None, badges=None):
    data = {"folders": folders, "excludes": excludes, "filters": filters or {}}
    if theme is not None:
        data["theme"] = theme
    if app_folders is not None:
        data["app_folders"] = {name: sorted(paths) for name, paths in app_folders.items()}
    if desktop_order is not None:
        data["desktop_order"] = list(desktop_order)
    if dock_paths is not None:
        data["dock_paths"] = list(dock_paths)
    if desktop_settings is not None:
        data["desktop_settings"] = desktop_settings
    if hidden_paths is not None:
        data["hidden_paths"] = sorted(hidden_paths)
    if badges is not None:
        data["badges"] = dict(badges)
    try:
        CONFIG_FILE.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    except OSError:
        pass


def _scan_context(folders, excludes, filters):
    return {
        "folders": sorted(os.path.normcase(os.path.abspath(path)) for path in folders),
        "excludes": sorted(os.path.normcase(os.path.abspath(path)) for path in excludes),
        "filters": filters,
    }


def _application_to_dict(app):
    return {
        "name": app.name,
        "path": app.path,
        "size": app.size,
        "modified": app.modified,
        "filter_note": app.filter_note,
        "metadata": {
            "file_description": app.metadata.file_description,
            "product_name": app.metadata.product_name,
            "company_name": app.metadata.company_name,
            "subsystem": app.metadata.subsystem,
            "has_icon": app.metadata.has_icon,
        },
    }


def _application_from_dict(data):
    metadata = data.get("metadata", {})
    return Application(
        name=str(data["name"]), path=str(data["path"]), size=int(data["size"]),
        modified=float(data["modified"]), filter_note=str(data.get("filter_note", "")),
        metadata=ExecutableInfo(
            file_description=str(metadata.get("file_description", "")),
            product_name=str(metadata.get("product_name", "")),
            company_name=str(metadata.get("company_name", "")),
            subsystem=metadata.get("subsystem"),
            has_icon=bool(metadata.get("has_icon", False)),
        ),
    )


def save_scan_cache(folders, excludes, filters, apps):
    payload = {"context": _scan_context(folders, excludes, filters),
               "applications": [_application_to_dict(app) for app in apps]}
    try:
        RESULT_CACHE_FILE.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    except OSError:
        pass


def load_scan_cache(folders, excludes, filters):
    try:
        payload = json.loads(RESULT_CACHE_FILE.read_text(encoding="utf-8"))
        if payload.get("context") != _scan_context(folders, excludes, filters):
            return []
        apps = []
        for item in payload.get("applications", []):
            app = _application_from_dict(item)
            try:
                stat = os.stat(app.path)
                if stat.st_size == app.size and stat.st_mtime == app.modified:
                    apps.append(app)
            except (OSError, ValueError, TypeError, KeyError):
                continue
        return apps
    except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError):
        return []


def create_rounded_rectangle(width, height, radius, color, shadow_color=None, border_color=None):
    """创建圆角矩形图像，支持阴影和边框"""
    if Image is None:
        return None
    try:
        if shadow_color:
            shadow_width = 3
            img = Image.new("RGBA", (width + shadow_width * 2, height + shadow_width * 2), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            shadow_rgba = shadow_color + (40,) if len(shadow_color) == 3 else shadow_color
            draw.rounded_rectangle(
                [(shadow_width, shadow_width), (width + shadow_width - 1, height + shadow_width - 1)],
                radius=radius, fill=shadow_rgba
            )
            img_blur = img.filter(Image.BLUR) if hasattr(Image, 'BLUR') else img
            result = Image.new("RGBA", (width, height), (0, 0, 0, 0))
            result.paste(img_blur, (0, 0), img_blur)
        else:
            result = Image.new("RGBA", (width, height), (0, 0, 0, 0))

        draw = ImageDraw.Draw(result)
        color_rgba = color + (255,) if len(color) == 3 else color
        draw.rounded_rectangle([(0, 0), (width - 1, height - 1)], radius=radius, fill=color_rgba)

        if border_color:
            border_rgba = border_color + (100,) if len(border_color) == 3 else border_color
            draw.rounded_rectangle([(0, 0), (width - 1, height - 1)], radius=radius, outline=border_rgba, width=1)

        return result
    except Exception:
        return None


def hex_to_rgb(hex_color):
    """将十六进制颜色转换为RGB元组"""
    hex_color = hex_color.lstrip("#")
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))


def create_button_background(width, height, color, is_hover=False, is_pressed=False):
    """创建按钮背景图像，支持hover和pressed状态"""
    if Image is None:
        return None
    try:
        img = Image.new("RGBA", (width, height), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)

        rgb = hex_to_rgb(color) if isinstance(color, str) else color
        if is_pressed:
            rgb = tuple(int(c * 0.7) for c in rgb)
        elif is_hover:
            rgb = tuple(min(255, int(c * 1.2)) for c in rgb)

        color_rgba = rgb + (255,)
        draw.rounded_rectangle([(0, 0), (width - 1, height - 1)], radius=4, fill=color_rgba)
        return img
    except Exception:
        return None


def create_card_background(width, height, color, border_color=None, shadow=False):
    """创建卡片背景图像，支持边框和阴影"""
    if Image is None:
        return None
    try:
        if shadow:
            shadow_width = 2
            img = Image.new("RGBA", (width + shadow_width * 2, height + shadow_width * 2), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            shadow_rgb = (0, 0, 0)
            draw.rounded_rectangle(
                [(shadow_width, shadow_width), (width + shadow_width - 1, height + shadow_width - 1)],
                radius=8, fill=shadow_rgb + (25,)
            )
            result = Image.new("RGBA", (width, height), (0, 0, 0, 0))
            result.paste(img, (-shadow_width, -shadow_width), img)
        else:
            result = Image.new("RGBA", (width, height), (0, 0, 0, 0))

        draw = ImageDraw.Draw(result)
        rgb = hex_to_rgb(color) if isinstance(color, str) else color
        color_rgba = rgb + (255,)
        draw.rounded_rectangle([(0, 0), (width - 1, height - 1)], radius=8, fill=color_rgba)

        if border_color:
            border_rgb = hex_to_rgb(border_color) if isinstance(border_color, str) else border_color
            draw.rounded_rectangle([(0, 0), (width - 1, height - 1)], radius=8, outline=border_rgb + (80,), width=1)

        return result
    except Exception:
        return None


def lighten_color(hex_color, amount=0.1):
    """淡化颜色"""
    rgb = hex_to_rgb(hex_color)
    rgb = tuple(min(255, int(c + (255 - c) * amount)) for c in rgb)
    return "#{:02x}{:02x}{:02x}".format(*rgb)


def darken_color(hex_color, amount=0.1):
    """深化颜色"""
    rgb = hex_to_rgb(hex_color)
    rgb = tuple(max(0, int(c * (1 - amount))) for c in rgb)
    return "#{:02x}{:02x}{:02x}".format(*rgb)


