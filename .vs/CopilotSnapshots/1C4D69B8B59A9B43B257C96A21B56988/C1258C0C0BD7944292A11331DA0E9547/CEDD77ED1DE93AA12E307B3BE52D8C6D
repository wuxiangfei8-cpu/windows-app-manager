    def apply_theme_config(self):
        """应用主题样式配置"""
        theme = THEMES.get(self.theme_name, THEMES["android"])
        style = ttk.Style(self)
        try:
            style.theme_use("vista")
        except tk.TclError:
            pass

        bg = theme["background"]
        fg = theme["text"]
        card_bg = theme["card"]
        accent = theme["accent"]
        muted = theme["muted"]

        style.configure("TButton", padding=(12, 6), font=("Segoe UI", 9),
                        background=card_bg, foreground=fg, borderwidth=0)
        style.map("TButton", 
                  background=[("pressed", theme.get("button_hover", accent)), ("active", theme.get("card_hover", card_bg))],
                  foreground=[("disabled", muted), ("!disabled", fg)])

        style.configure("TLabel", background=bg, foreground=fg)
        style.configure("TFrame", background=bg)
        style.configure("TLabelframe", background=bg, foreground=fg)
        style.configure("TLabelframe.Label", background=bg, foreground=fg)
